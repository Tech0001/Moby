# Moby Environment Configuration

# Database path (optional, defaults to ./data/moby.db)
# DB_PATH=./data/moby.db

# Config file path (optional, defaults to ./config.yaml)
# CONFIG_PATH=./config.yaml

# Data directory (optional, defaults to ./data)
# DATA_DIR=./data

# Encryption key for API credentials stored in the database
# This key is auto-generated on first run if not set.
# IMPORTANT: Back up this key! If lost, stored API credentials cannot be decrypted.
# Generate a new key: openssl rand -hex 32
# MOBY_ENCRYPTION_KEY=your-64-character-hex-key-here
