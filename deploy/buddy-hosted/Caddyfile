# Caddy configuration for buddy-hosted sweepers
# Uses automatic HTTPS with Let's Encrypt

{
  email {$ACME_EMAIL}
}

# Wildcard or individual subdomains
*.{$DOMAIN} {
  # Route to the appropriate sweeper container based on subdomain
  # Caddy-docker-proxy handles this automatically via labels

  # Security headers
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    X-XSS-Protection "1; mode=block"
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }

  # Logging
  log {
    output file /var/log/caddy/access.log
    format json
  }
}
