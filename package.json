{
  "name": "Moby",
  "version": "1.0.0",
  "description": "Self-hosted daemon that monitors Kraken trades and auto-withdraws to pre-saved addresses",
  "author": {
    "name": "Moby",
    "email": "support@moby.app"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm rebuild better-sqlite3 bcrypt && tsx watch src/server/app.ts",
    "dev:fast": "tsx watch src/server/app.ts",
    "dev:ui": "vite",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "start": "node dist/server/app.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "migrate": "tsx src/server/db/migrate.ts",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac --arm64",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "npm ci": "npm ci",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-nodejs": "^15.0.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^14.4.2",
    "@terra-money/terra.js": "^3.1.10",
    "algosdk": "^3.5.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.5.0",
    "bitcoinjs-lib": "^7.0.0",
    "cookie-parser": "^1.4.7",
    "ecpair": "^3.0.0",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "long": "^5.3.2",
    "lucide-react": "^0.561.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "tiny-secp256k1": "^2.2.4",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "xrpl": "^4.4.3",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
